% Presentation mechanics and a neutral base look.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{slides}[2026/08/29 Neutral beamer base and figure animations]

\RequirePackage{graphicx}
\RequirePackage{pdfpages}
\RequirePackage{tikz}

\mode<presentation>

\RequirePackage{times}
\RequirePackage{helvet}
\RequirePackage{courier}

% Serif throughout, including math, rather than beamer's sans default.
\def\beamer@tsfont{\rmfamily}
\def\beamer@sfont{\rmfamily}
\def\familydefault{\rmdefault}
\def\mathfamilydefault{\rmdefault}
\beamer@sansmathfalse
\setbeamerfont{tiny structure}{family=\beamer@tsfont}
\setbeamerfont{structure}{family=\beamer@sfont}
\setbeamerfont{frametitle}{series=\bfseries,parent=structure}

\renewcommand{\footnotesize}{\fontsize{7pt}{9pt}\selectfont}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}[circle]
\setbeamertemplate{blocks}[rounded]
% \setbeamercovered

% Footnote carrying no marker, for attributions in a slide corner.
\newcommand\blfootnote[1]{%
    \begingroup
    \renewcommand\thefootnote{}\footnote{#1}%
    \addtocounter{footnote}{-1}%
    \endgroup
}

% \blfootcite{<key>}: full reference as a \blfootnote; the document loads biblatex.
\newcommand\blfootcite[1]{\blfootnote{\fullcite{#1}}}

% \animation[<bib key>]{<title>}{<handout list>}{<presentation list>}
% With a bib key, every frame carries its \blfootcite.

\newcommand\slides@animframe[3]{%
    \frame{%
        \frametitle{#1}%
        \centering
        \includegraphics[width=\textwidth,height=0.7\textheight,keepaspectratio]{#2}%
        \IfValueT{#3}{\blfootcite{#3}}%
    }%
}

\ExplSyntaxOn

\int_new:N \l__slides_step_int
\int_new:N \l__slides_total_int

\NewDocumentCommand \slidesAnimate { o m m }
{
    \int_zero:N \l__slides_step_int
    \int_set:Nn \l__slides_total_int { \clist_count:n {#3} }
    \clist_map_inline:nn {#3}
    {
        \int_incr:N \l__slides_step_int
        \int_compare:nNnTF { \l__slides_total_int } > { 1 }
            {
                \slides@animframe
                { #2 ~ ( \int_use:N \l__slides_step_int / \int_use:N \l__slides_total_int ) }
                {##1} {#1}
            }
            { \slides@animframe {#2} {##1} {#1} }
    }
}

\ExplSyntaxOff

% \ifelsehandout{<handout>}{<presentation>}
% Splitting on handout rather than naming modes keeps trans working.
\newcommand\ifelsehandout[2]{#2}
\mode<handout>{\renewcommand\ifelsehandout[2]{#1}}

% The branch wraps the whole call: passing \ifelsehandout as the list argument would
% hand \clist_count:n an unexpanded macro rather than a comma list.
\NewDocumentCommand\animation{o m m m}{\ifelsehandout{\slidesAnimate[#1]{#2}{#3}}{\slidesAnimate[#1]{#2}{#4}}}

% \includeslides[<venue>]{<pdf>}{<page list>}{<bib key>}
% Pages at their own size, without the theme background, attributed in the bottom-left corner
% with the venue, or the entry's year when no venue is given.

\newcommand\slides@attribution[2]{%
    \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=south west, inner sep=2pt, font=\tiny]
        at (current page.south west)
        {\citeauthor{#2}, \citetitle{#2}\IfValueTF{#1}{, #1}{ (\citeyear{#2})}};
    \end{tikzpicture}%
}

\NewDocumentCommand\includeslides{o m m m}{{%
            \setbeamertemplate{background}{}%
            \includepdf[pages={#3}, fitpaper=true, pagecommand={\slides@attribution{#1}{#4}}]{#2}%
        }}

\mode<all>
